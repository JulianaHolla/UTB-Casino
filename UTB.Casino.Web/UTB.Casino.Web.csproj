<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>utb-casino-web-5b1d7c2e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The web project is the only one that knows both Application and Infrastructure (they do not know each other). -->
    <ProjectReference Include="../UTB.Casino.Application/UTB.Casino.Application.csproj" />
    <ProjectReference Include="../UTB.Casino.Domain/UTB.Casino.Domain.csproj" />
    <ProjectReference Include="../UTB.Casino.Infrastructure/UTB.Casino.Infrastructure.csproj" />
  </ItemGroup>

</Project>
